{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "bedrock.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "__ACCOUNT_ID__" },
        "ArnLike": { "aws:SourceArn": "arn:aws:bedrock:__REGION__:__ACCOUNT_ID__:knowledge-base/*" }
      }
    }
  ]
}
